# Project config (contains API tokens — never commit)
config.yaml

# Last.fm session key emitted by get_lastfm_session_key.py (write-scope secret)
lastfm_session_key.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
env/
.venv/

# Cover art cache
src/display/assets/cache/

# Logs
*.log
logs/
log.md

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Test artifacts
.pytest_cache/
.coverage
htmlcov/

# Local-only code review reports (findings live in GitHub issues; see MEMORY)
CODE_REVIEW_*.md

# Local-only wave/round handoff notes (working artifacts of the audit loop;
# the durable record lives in CHANGELOG.md + GitHub issues — never committed)
HANDOFF-*.md

# Local-only handoff/review patch artifacts (delivered per-finding, applied on
# the Mac, then parked in docs/archive/ — never committed; keeps `git add -A` from re-polluting)
*.patch

# Local audit archive (handoffs, reviews, patches) - never committed
/docs/archive/

# AI-assistant / development-process files — kept LOCAL, never on the public repo.
# The public repo tracks product artifacts only (code, product/ops docs, tests).
# AI-agent instructions and config
CLAUDE.md
AGENTS.md
.claude/
.mcp.json
# Wave / round / remediation audit working artifacts (durable record is CHANGELOG
# + GitHub issues)
/r*-issue-map.tsv
/file_issues_r*.sh
/RELEASE-NOTES-v*.md
/docs/superpowers/
/docs/decisions/remediation-guardrails.md
# Impeccable design-tool data (local design workflow, not a product artifact)
/design/.impeccable/
